                "host",
                "polls",
                "{{pollId}}",
                ""
              ]
            },
            "description": "Fechada → Aberta é recusado: o estado só avança.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"open\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Resultados finais (público)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/polls/{{pollId}}/results/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "polls",
                "{{pollId}}",
                "results",
                ""
              ]
            },
            "description": "Depois de fechada, os resultados são públicos."

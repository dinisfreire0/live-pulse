              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/host/polls/{{pollId}}/stream/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "host",
                "polls",
                "{{pollId}}",
                "stream",
                ""
              ]
            },
            "description": "Server-Sent Events: envia um snapshot da votação sempre que algo muda. Só faz sentido com a votação aberta; no Postman, abre e deixa a correr."
          }
        }
      ]
    },
    {
      "name": "Público",
      "item": [
        {
          "name": "Listar votações",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/polls/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "polls",
                ""
              ]
            },
            "description": "Só votações Abertas e Fechadas (rascunhos nunca aparecem)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"

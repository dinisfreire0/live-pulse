              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "polls",
                "{{pollId}}",
                ""
              ]
            },
            "description": "`results` é `null` enquanto a votação está aberta (salvo resultados em direto). `has_voted` usa o header `X-Voter-Token`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Votar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/polls/{{pollId}}/votes/",
              "host": [

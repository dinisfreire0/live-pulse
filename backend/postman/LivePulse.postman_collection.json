{
  "info": {
    "name": "Live Pulse API",
    "description": "API REST do Live Pulse.\n\nCorre a pasta **Fluxo completo** de uma ponta à outra (Run collection / `newman`) para ver o ciclo de vida de uma votação: criar → abrir → votar → fechar → resultados.\n\nAs pastas **Anfitrião** e **Público** têm cada endpoint individualmente. Variáveis: `baseUrl`, `pollId` e `optionId` (preenchidas ao criar uma votação) e `voterToken`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Fluxo completo",
      "item": [
        {
          "name": "Criar votação",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/host/polls/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "host",
                "polls",
                ""
              ]
            },
            "description": "Cria uma votação em Rascunho (2 a 5 opções). Guarda `pollId` e `optionId` nas variáveis da coleção.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"Qual o tema da próxima sessão?\",\n  \"options\": [\n    \"Django\",\n    \"React\",\n    \"Docker\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const poll = pm.response.json();",
                  "pm.test(\"Começa em Rascunho\", () => pm.expect(poll.status).to.eql(\"draft\"));",
                  "pm.collectionVariables.set(\"pollId\", poll.id);",
                  "pm.collectionVariables.set(\"optionId\", poll.options[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Criar votação (inválida)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/host/polls/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "host",
                "polls",
                ""
              ]
            },
            "description": "Exemplo de validação: pergunta vazia e menos de 2 opções.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"\",\n  \"options\": [\n    \"Só uma\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
                  "const errors = pm.response.json();",
                  "pm.test(\"Erros por campo\", () => pm.expect(errors).to.have.keys(\"question\", \"options\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Abrir votação",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/host/polls/{{pollId}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "host",
                "polls",
                "{{pollId}}",
                ""
              ]
            },
            "description": "Rascunho → Aberta. Opcionalmente com `duration_seconds` para fechar automaticamente.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"open\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Aberta\", () => pm.expect(pm.response.json().status).to.eql(\"open\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar votações",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/polls/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "polls",
                ""
              ]
            },
            "description": "Só votações Abertas e Fechadas (rascunhos nunca aparecem)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Detalhe da votação",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Voter-Token",
                "value": "{{voterToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/polls/{{pollId}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "polls",
                "{{pollId}}",
                ""
              ]
            },
            "description": "`results` é `null` enquanto a votação está aberta (salvo resultados em direto). `has_voted` usa o header `X-Voter-Token`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Votar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/polls/{{pollId}}/votes/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "polls",
                "{{pollId}}",
                "votes",
                ""
              ]
            },
            "description": "Regista um voto. Respostas: 400 (opção inválida), 404 (rascunho), 409 (já votou ou votação não aberta).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"option_id\": {{optionId}},\n  \"voter_token\": \"{{voterToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Votar outra vez (recusado)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/polls/{{pollId}}/votes/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "polls",
                "{{pollId}}",
                "votes",
                ""
              ]
            },
            "description": "O mesmo `voter_token` não pode votar duas vezes na mesma votação.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"option_id\": {{optionId}},\n  \"voter_token\": \"{{voterToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Resultados (votação aberta)",
          "request": {
            "method": "GET",
            "header": [],

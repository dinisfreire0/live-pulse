                "{{pollId}}",
                ""
              ]
            },
            "description": "Aberta → Fechada. Não é possível voltar atrás.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"closed\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]

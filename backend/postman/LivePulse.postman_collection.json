          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const results = pm.response.json();",
                  "pm.test(\"1 voto contado\", () => pm.expect(results.total_votes).to.eql(1));"
                ]
              }
            }
          ]
        }
      ]
    },

# Copy this file to `.env` (cp .env.example .env). Every value is optional:
# the defaults in backend/settings.py are fine for local development.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Where the SQLite database lives (defaults to backend/db.sqlite3).
# SQLITE_PATH=/app/data/db.sqlite3
